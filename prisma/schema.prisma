// Business OS — схема данных.
//
// Конвенции (канон плана, §1 «Канонические конвенции»):
//   • Деньги — ВСЕГДА Int в копейках (никаких Float/Decimal для сумм).
//     Предел Int ≈ 21,4 млн ₽ на одну операцию — достаточно; при импорте
//     выписок суммы проверяются на переполнение.
//   • Один пользователь: userId в моделях нет, но «личность» владельца живёт
//     в Settings/env, а не в хардкоде — чтобы продукт можно было продать.
//   • Все временные метки — UTC; периоды бизнес-логики режутся по
//     Europe/Moscow (см. src/core/shared/time.ts).
//
// Векторная память: колонка embedding объявлена как Unsupported("vector(1536)")
// — Prisma её не типизирует, поиск идёт raw SQL (`<=>`), HNSW-индекс создаётся
// в ручной миграции.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Neon: pooled-строка (…-pooler…, PgBouncer) — для приложения.
  url        = env("DATABASE_URL")
  // Neon: прямая строка — для миграций (PgBouncer их не пропускает).
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─────────────────────────── Ядро: настройки владельца ───────────────────────

/// Singleton (id = "owner"). Всё, что делает систему «личной», живёт здесь.
model Settings {
  id          String @id @default("owner")
  displayName String @default("Владелец")
  timezone    String @default("Europe/Moscow")

  /// Профиль-«конституция» для системного промпта: ценности, график, цели,
  /// предпочтения по тону. Редактируется в UI и (с подтверждением) агентом.
  ownerProfile Json @default("{}")

  /// Настройки интерфейса (privacy mode и т.п.).
  uiPrefs Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Ядро: диалог ────────────────────────────────────

enum Channel {
  WEB
  TELEGRAM
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// Диалог с агентом. Web и Telegram делят историю: у секретаря один активный
/// тред на канал, начатый разговор продолжается на другом устройстве.
model Conversation {
  id       String  @id @default(cuid())
  agentKey String  @default("secretary") // secretary | finance | sales
  channel  Channel @default(WEB)
  title    String?

  /// Саммари вытесненной из окна истории (фаза 1.5).
  summary  String?
  archived Boolean @default(false)

  messages  Message[]
  runs      AgentRun[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([agentKey, channel, archived, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  /// tool_calls модели / результат инструмента — сырой JSON провайдера.
  toolCalls Json?
  /// Имя инструмента для role=TOOL.
  toolName  String?

  tokens    Int?
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────── Ядро: журнал агентов ────────────────────────────

enum AgentRunTrigger {
  CHAT
  TELEGRAM
  CRON
  MANUAL
}

enum AgentRunStatus {
  RUNNING
  OK
  ERROR
  CANCELLED
}

/// Один запуск агентного цикла. Журнал нужен и для отладки, и для ленты
/// активности в UI («что агент делал, пока меня не было»).
model AgentRun {
  id             String        @id @default(cuid())
  agentKey       String
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  trigger AgentRunTrigger
  status  AgentRunStatus  @default(RUNNING)

  iterations Int     @default(0)
  error      String?

  actions    AgentAction[]
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([agentKey, startedAt])
  @@index([status, startedAt])
}

enum AgentActionStatus {
  OK
  ERROR
  PENDING_APPROVAL
  REJECTED
}

/// Один вызов инструмента внутри запуска. `dangerous`-инструменты не
/// исполняются сразу — создают Notification типа APPROVAL_REQUIRED.
model AgentAction {
  id    String   @id @default(cuid())
  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  seq      Int
  toolName String

  /// Аргументы и результат. Поля, помеченные инструментом как sensitive,
  /// маскируются ДО записи.
  input  Json
  output Json?

  status     AgentActionStatus @default(OK)
  durationMs Int?
  createdAt  DateTime          @default(now())

  @@unique([runId, seq])
  @@index([toolName, createdAt])
}

// ─────────────────────────── Ядро: память ────────────────────────────────────

enum MemoryCategory {
  BUSINESS
  FINANCE
  HEALTH
  PSYCHOLOGY
  PREFERENCE
  GOAL
  RELATIONSHIP
  HISTORY
}

/// Атомарный факт о владельце. Извлекается ночной джобой day-summary дешёвой
/// моделью и вручную через инструмент save_memory_fact.
/// Поиск — по вектору (raw SQL), плюс все pinned всегда попадают в промпт.
model MemoryFact {
  id       String         @id @default(cuid())
  text     String
  category MemoryCategory @default(BUSINESS)

  /// 1 — фон, 2 — обычный, 3 — важный (всегда в контексте вместе с pinned).
  importance Int     @default(2)
  pinned     Boolean @default(false)
  active     Boolean @default(true)

  /// Откуда факт: runId, "manual", "day-summary".
  source    String?
  expiresAt DateTime?

  /// Векторное представление text. Prisma не типизирует — запись и поиск
  /// идут raw SQL, см. src/core/memory/.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, pinned, importance])
  @@index([category, createdAt])
}

// ─────────────────────────── Ядро: задачи и напоминания ──────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum EntitySource {
  WEB
  TELEGRAM
  AGENT
  CRON
}

model Task {
  id    String  @id @default(cuid())
  title String
  note  String?

  status   TaskStatus @default(TODO)
  /// 1 — высокий, 2 — обычный, 3 — низкий.
  priority Int        @default(2)

  /// Модуль-владелец: personal | finance | sales | dev.
  module String    @default("personal")
  dueAt  DateTime?

  source      EntitySource @default(WEB)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reminders Reminder[]

  @@index([status, dueAt])
  @@index([module, status])
}

/// Пресеты повторения вместо полного RRULE — сознательное упрощение плана:
/// парсер RRULE не нужен, а 95% случаев покрываются четырьмя вариантами.
enum RepeatPreset {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

model Reminder {
  id   String @id @default(cuid())
  text String

  /// Ближайшее срабатывание в UTC. Денормализовано специально под минутный
  /// поллер: один индексный запрос вместо разбора расписаний на каждом тике.
  nextFireAt   DateTime
  repeatPreset RepeatPreset?

  channel  Channel @default(TELEGRAM)
  isActive Boolean @default(true)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  lastFiredAt DateTime?
  source      EntitySource @default(WEB)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive, nextFireAt])
}

// ─────────────────────────── Ядро: уведомления и события ─────────────────────

enum NotificationType {
  INFO
  WARNING
  APPROVAL_REQUIRED
  DIGEST
}

enum NotificationResolution {
  APPROVED
  REJECTED
}

model Notification {
  id     String           @id @default(cuid())
  type   NotificationType @default(INFO)
  module String?

  title String
  body  String?

  /// Для APPROVAL_REQUIRED: {actionId, toolName, args}.
  payload Json?

  readAt     DateTime?
  resolvedAt DateTime?
  resolution NotificationResolution?

  createdAt DateTime @default(now())

  @@index([readAt, createdAt])
  @@index([type, resolvedAt])
}

/// Шина значимых событий модулей. Читают: утренний бриф, генератор инсайтов,
/// лента активности в UI.
model DomainEvent {
  id      String @id @default(cuid())
  module  String // secretary | finance | sales | system
  type    String // payment.received | lead.stage_changed | …
  title   String
  payload Json   @default("{}")

  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([module, occurredAt])
}

// ─────────────────────────── Ядро: учёт LLM ──────────────────────────────────

/// Пишется в LLM-шлюзе на КАЖДЫЙ вызов (не только агентный) — иначе
/// категоризация импорта, скоринг лидов и эмбеддинги остаются вне учёта.
model LlmUsage {
  id String @id @default(cuid())

  /// Что именно потратило токены: secretary.chat, finance.import,
  /// sales.scoring, memory.embed, …
  feature String
  preset  String // smart | heavy | cheap | embed
  gateway String // polza | proxyapi
  model   String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Оценка стоимости в копейках (тарифы — в конфиге шлюза).
  costKop Int @default(0)

  latencyMs Int?
  ok        Boolean @default(true)
  error     String?

  runId     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

// ─────────────────────────── Ядро: дедуп вебхуков ────────────────────────────

/// Durable-дедуп входящих апдейтов (Telegram update_id и т.п.). In-memory
/// недостаточно: контейнер перезапускается при каждом деплое, а Telegram
/// ретраит недоставленное — без этого владелец получал бы дубли ответов.
model WebhookDedup {
  id         String   @id @default(cuid())
  source     String // telegram
  externalId String
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([createdAt])
}

// ─────────────────────── Секретарь: жизнь владельца ──────────────────────────

/// Сфера жизни для «колеса баланса». Сидится восемью значениями.
model LifeArea {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  icon      String?
  color     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  scores    LifeAreaScore[]
  goals     Goal[]
  createdAt DateTime        @default(now())
}

/// Ежемесячная самооценка сферы, 1–10.
model LifeAreaScore {
  id     String   @id @default(cuid())
  areaId String
  area   LifeArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  /// Ключ месяца по московскому времени: "2026-07".
  period String
  score  Int
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, period])
  @@index([period])
}

enum CheckInKind {
  MORNING
  EVENING
}

/// Чек-ин состояния. Шкалы 1–5: мельче человек не различает, крупнее —
/// превращается в гадание.
model CheckIn {
  id   String      @id @default(cuid())
  /// Локальная дата владельца, по ней же идёт защита от второго чек-ина за день.
  date DateTime    @db.Date
  kind CheckInKind @default(EVENING)

  mood   Int?
  energy Int?
  stress Int?
  note   String?

  source    EntitySource @default(TELEGRAM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([date, kind])
  @@index([date])
}

enum JournalKind {
  NOTE
  DAY_SUMMARY
  WEEKLY_RETRO
  MONTHLY_REVIEW
}

enum JournalAuthor {
  OWNER
  ASSISTANT
}

/// Дневник: записи владельца и сводки, которые пишет агент.
model JournalEntry {
  id         String        @id @default(cuid())
  kind       JournalKind   @default(NOTE)
  authoredBy JournalAuthor @default(OWNER)

  title   String?
  content String

  /// Ключ дня для идемпотентности суточных сводок: "2026-07-29".
  dayKey String?

  createdAt DateTime @default(now())

  @@unique([kind, dayKey])
  @@index([kind, createdAt])
}

enum GoalStatus {
  ACTIVE
  DONE
  PAUSED
  DROPPED
}

/// Цель владельца. Денежные значения — В КОПЕЙКАХ, как и везде в системе.
model Goal {
  id     String    @id @default(cuid())
  title  String
  areaId String?
  area   LifeArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// Что измеряем: "выручка", "клиенты", "тренировки в неделю".
  metricName   String?
  /// Денежные цели — в копейках; неденежные — в своих единицах.
  targetValue  Int?
  currentValue Int?
  /// true — значения трактуются как копейки (для форматирования).
  isMoney      Boolean @default(false)

  deadline DateTime?
  status   GoalStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deadline])
}

/// Утренний бриф. Одна запись на день — по ней же идемпотентность крона.
model DailyBrief {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  /// Готовый текст для Telegram и экрана.
  content String
  /// Агрегаты, из которых он собран: интерфейс рисует карточки по ним, а не
  /// разбирает текст обратно.
  data    Json    @default("{}")
  focus   String?

  sentToTelegramAt DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
}

// ─────────────────────────── Финансы ─────────────────────────────────────────
//
// Все суммы — Int в КОПЕЙКАХ. Ни одного Float и ни одного Decimal: Float даёт
// расхождение с банком на сотне операций, Decimal ломает сериализацию через
// границу Server Components.

enum AccountKind {
  BANK_CARD
  BANK_ACCOUNT
  CASH
  YOOKASSA
  OTHER
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TxSource {
  MANUAL
  SECRETARY
  TELEGRAM
  IMPORT
  YOOKASSA
  RECURRING
}

model Account {
  id       String      @id @default(cuid())
  name     String
  kind     AccountKind @default(BANK_CARD)
  currency String      @default("RUB")

  /// Остаток на дату открытия учёта — от него считается текущий баланс.
  openingBalanceKop Int      @default(0)
  openingDate       DateTime @default(now())

  isArchived   Boolean   @default(false)
  /// Счёт по умолчанию: на него уходят операции, когда владелец не назвал счёт
  /// («потратил 3500 на бензин»). Уникальностью не защищён намеренно — выбор
  /// всё равно детерминирован сортировкой (isDefault desc, createdAt asc),
  /// а лишнее ограничение мешало бы менять счёт по умолчанию одним апдейтом.
  isDefault    Boolean   @default(false)
  /// Курсор инкрементального синка (для счёта ЮKassa).
  lastSyncedAt DateTime?
  /// Служебные поля интеграции. Секретов здесь нет — они только в env.
  meta         Json?

  transactions   Transaction[]   @relation("TxAccount")
  transfersIn    Transaction[]   @relation("TxTransferTarget")
  recurringItems RecurringItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  color      String?
  isPersonal Boolean @default(false)
  isArchived Boolean @default(false)

  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String
  type TxType

  /// Два уровня: «Маркетинг → Реклама». Глубже не нужно.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  /// Синонимы для разбора фразы владельца: «реклама, таргет, директ».
  aliases String[] @default([])
  /// Правила автокатегоризации импорта: [{contains:"YANDEX"},{mcc:5968}].
  rules   Json?

  isBusiness Boolean @default(true)
  icon       String?
  color      String?
  sortOrder  Int     @default(0)
  isArchived Boolean @default(false)

  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  createdAt DateTime @default(now())

  @@unique([name, type])
  @@index([type, isArchived])
}

model Transaction {
  id   String   @id @default(cuid())
  type TxType
  /// Дата операции. Точность до дня важна для дедупа импорта.
  date DateTime

  /// ВСЕГДА положительное число; направление задаёт type.
  amountKop Int

  accountId String
  account   Account @relation("TxAccount", fields: [accountId], references: [id])

  /// Счёт-получатель для type = TRANSFER.
  transferAccountId String?
  transferAccount   Account? @relation("TxTransferTarget", fields: [transferAccountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  counterparty String?
  note         String?
  source       TxSource @default(MANUAL)

  /// Идентификатор во внешней системе (платёж ЮKassa).
  externalId String?
  /// sha256(счёт|день|сумма|нормализованное описание) — защита от повторного импорта.
  dedupKey   String?

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  recurringItemId String?
  recurringItem   RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)

  /// mcc, способ оплаты, исходное описание из выписки.
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([accountId, dedupKey])
  @@index([date])
  @@index([type, date])
  @@index([categoryId, date])
  @@index([projectId, date])
}

/// План расходов или доходов на месяц.
///
/// projectId NOT NULL со спец-проектом «—» намеренно: в Postgres NULL ≠ NULL,
/// и уникальность «месяц + категория без проекта» с nullable-полем не
/// работала бы — можно было бы завести два бюджета на одно и то же.
model Budget {
  id    String   @id @default(cuid())
  /// Первое число месяца.
  month DateTime

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  plannedKop Int
  rollover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, categoryId, projectId])
  @@index([month])
}

/// Регулярный платёж или поступление: хостинг, подписки, аренда.
model RecurringItem {
  id   String @id @default(cuid())
  name String
  type TxType

  amountKop  Int
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// monthly | yearly — пресеты, как у напоминаний.
  cadence     String   @default("monthly")
  nextDueDate DateTime
  /// true — джоба сама создаёт операцию в срок.
  autoCreate  Boolean  @default(false)
  isActive    Boolean  @default(true)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, nextDueDate])
}

enum FinGoalKind {
  TARGET
  PLAYBOOK
}

enum FinGoalStatus {
  ACTIVE
  ARMED
  TRIGGERED
  ACKNOWLEDGED
  ACHIEVED
  ARCHIVED
}

/// Цель по доходу или «руководство к действию» с порогом.
model FinancialGoal {
  id   String      @id @default(cuid())
  kind FinGoalKind @default(TARGET)
  name String

  /// monthly_revenue | mrr | profit | runway_months | balance
  metric       String
  direction    String @default("gte")
  /// Денежные пороги — в копейках; runway — в сотых месяца.
  thresholdKop Int?

  deadline   DateTime?
  /// Markdown-план действий для PLAYBOOK.
  playbookMd String?

  status      FinGoalStatus @default(ACTIVE)
  triggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, kind])
}

enum InsightKind {
  ANOMALY
  TREND
  BUDGET_ALERT
  RECOMMENDATION
  PLAYBOOK_TRIGGER
  MONTHLY_REPORT
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
  OPPORTUNITY
}

/// Карточка наблюдения по финансам.
model Insight {
  id       String          @id @default(cuid())
  kind     InsightKind
  severity InsightSeverity @default(INFO)

  title  String
  bodyMd String

  /// Числа-основания, посчитанные КОДОМ. По ним интерфейс показывает «расчёт»,
  /// и по ним же проверяется, что модель не сослалась на выдуманное.
  factsJson Json @default("{}")
  actions   Json @default("[]")

  /// "2026-07" | "2026-W31" — период, к которому относится наблюдение.
  periodKey String
  /// kind + periodKey + предмет: одно наблюдение на тему в период.
  dedupKey  String @unique

  status    String    @default("new")
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

enum ImportStatus {
  UPLOADED
  PARSING
  PREVIEW
  NEEDS_REVIEW
  COMMITTED
  FAILED
  CANCELLED
}

/// Загруженная выписка: от файла до подтверждённых операций.
model ImportBatch {
  id       String  @id @default(cuid())
  fileName String
  /// tbank | sber | unknown
  bankHint String?
  format   String  @default("csv")

  status ImportStatus @default(UPLOADED)

  /// Сырой файл. Удаляется джобой через 30 дней после коммита: держать
  /// банковские выписки дольше незачем.
  rawFile    Bytes?
  /// Строки предпросмотра до подтверждения.
  parsedRows Json?
  /// {total, new, duplicates, transfers, sumKop, controlSumOk}
  stats      Json?
  error      String?

  transactions Transaction[]

  createdAt   DateTime  @default(now())
  committedAt DateTime?

  @@index([status, createdAt])
}

/// Кэш посчитанных агрегатов за период — чтобы дашборд не пересчитывал всё
/// при каждом открытии.
model FinanceSnapshot {
  id         String   @id @default(cuid())
  periodKey  String   @unique
  data       Json
  computedAt DateTime @updatedAt
}

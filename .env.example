# ─────────────────────────── База данных (Neon) ──────────────────────────────
# Две строки обязательны: приложение ходит через пул (PgBouncer), миграции —
# напрямую (PgBouncer их не пропускает).
# Взять в консоли Neon → Connection string:
#   • pooled  — хост с суффиксом «-pooler», добавить &pgbouncer=true
#   • direct  — тот же хост БЕЗ «-pooler»
# Перед первой миграцией выполнить в SQL-консоли Neon:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
# Scale-to-zero на бесплатном тарифе отключить нельзя, и это учтено: крон
# напоминаний держит ближайший срок в памяти, а проба живости контейнера ходит
# на /api/health/live — роут без базы. /api/health базу трогает: он для
# диагностики руками, по таймеру его дёргать не надо.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/business_os?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/business_os?sslmode=require"

# ─────────────────────────── Приложение ──────────────────────────────────────
APP_URL="https://os.example.com"
# Подпись cookie-сессии. Сгенерировать: openssl rand -base64 48
AUTH_SECRET=""
# Хэш пароля владельца (argon2id). Сгенерировать: npm run hash:password -- 'мой-пароль'
OWNER_PASSWORD_HASH=""
# Часовой пояс владельца — по нему режутся сутки, месяцы и все отчёты.
# По умолчанию Asia/Yekaterinburg. Менять при переезде: расписание кронов в
# scripts/start-container.mjs задано в UTC и подобрано под этот пояс, так что
# сдвигать надо и его — иначе утренний бриф придёт не утром.
# OWNER_TZ="Asia/Yekaterinburg"
# Сколько прокси перед приложением считать доверенными при разборе
# x-forwarded-for. От этого зависит, по чьему адресу считается лимит попыток
# входа. 1 (по умолчанию) — верно для Timeweb напрямую. Поставите перед
# приложением ещё один прокси (например Cloudflare) — увеличьте на единицу,
# иначе лимит начнёт считаться по адресу прокси и перестанет защищать.
# TRUSTED_PROXY_HOPS="1"
# Авторизация внутренних крон-вызовов. Сгенерировать: openssl rand -hex 32
CRON_SECRET=""

# ─────────────────────────── LLM-шлюзы ───────────────────────────────────────
# Порядок каскада: первый доступный обслуживает запрос, при провале — следующий.
# Можно оставить один шлюз (LLM_GATEWAYS="polza") — всё работает, но резерва при
# его сбое не будет. Второй ключ добавляется переменной, без правок кода.
LLM_GATEWAYS="polza,proxyapi"
POLZA_API_KEY=""
PROXYAPI_API_KEY=""
# Переопределение моделей по ролям (необязательно — есть дефолты на каждый шлюз).
# Глобальное переопределение применяется ТОЛЬКО к шлюзам с тем же стилем id
# (Polza — namespace «provider/model», ProxyAPI — плоские OpenAI-совместимые):
# иначе LLM_MODEL_SMART="anthropic/..." подставился бы и в ProxyAPI, где такой
# модели нет, и резервный шлюз молча перестал бы работать.
# LLM_MODEL_SMART="anthropic/claude-sonnet-4.5"
# LLM_MODEL_HEAVY="anthropic/claude-opus-4.1"
# LLM_MODEL_CHEAP="openai/gpt-4o-mini"
# LLM_MODEL_EMBED="text-embedding-3-small"
# Точечное переопределение на конкретный шлюз — важнее глобального:
# POLZA_MODEL_SMART="anthropic/claude-sonnet-4.5"
# PROXYAPI_MODEL_CHEAP="gpt-4o-mini"
# Свой адрес шлюза (если провайдер сменил домен):
# POLZA_BASE_URL="https://polza.ai/api/v1"
# PROXYAPI_BASE_URL="https://api.proxyapi.ru/openai/v1"
# Кулдаун circuit-breaker'а деградировавшего шлюза, мс (по умолчанию 45000).
# LLM_BREAKER_COOLDOWN_MS="45000"
# Дневной потолок расходов на LLM в рублях — при превышении шлюз отказывает
# в необязательных вызовах и шлёт алерт (0 = без лимита).
LLM_DAILY_BUDGET_RUB="500"

# ─────────────────────────── Telegram ────────────────────────────────────────
# Личный бот владельца (НЕ бот Agentus). Создать у @BotFather.
TELEGRAM_BOT_TOKEN=""
# Исходящий трафик через Cloudflare Worker: прямой api.telegram.org из Timeweb
# заблокирован, без прокси бот не сможет отправлять сообщения вообще.
# Собственный домен НЕ нужен — подойдёт бесплатный адрес Worker'а
# *.workers.dev (см. infra/cloudflare-worker/README.md).
# Без схемы тоже работает — она подставится.
TELEGRAM_API_BASE="https://telegram-proxy.example.workers.dev"
# Публичная база для setWebhook: вебхук ставится на Worker, он форвардит на
# прод. Прямая доставка Telegram → РФ-хостинг ретраится минутами.
TELEGRAM_WEBHOOK_BASE="https://telegram-proxy.example.workers.dev"
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Единственный chat_id, который бот обслуживает. Узнать: @userinfobot
TELEGRAM_OWNER_CHAT_ID=""

# ─────────────────────────── Распознавание речи ──────────────────────────────
# НЕ РЕАЛИЗОВАНО: на голосовое сообщение бот отвечает, что не поддерживает его.
# Переменные оставлены как задел — задавать их сейчас смысла нет.
STT_PROVIDER="proxyapi"
STT_MODEL="gpt-4o-mini-transcribe"

# ─────────────────────────── Интеграции ──────────────────────────────────────
# ЮKassa: ОТДЕЛЬНЫЙ ключ только на чтение платежей. ЧИТАЕТСЯ кодом — синк
# поступлений работает, крон yookassa-sync ходит четыре раза в сутки.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Лидоген: официальные API, скрапинг каталогов запрещён — он нарушает
# пользовательские соглашения Яндекса и 2ГИС.
#
# YANDEX_GEO_API_KEY читается: коннектор Geosearch готов. Пока ключа нет,
# источник просто не предлагается — это нормальное состояние, не ошибка.
# Ключ уходит в query string (заголовочной авторизации у Geosearch нет),
# поэтому URL нигде не логируется, а из текста ошибок ключ вырезается.
YANDEX_GEO_API_KEY=""
# Суточный кап и частота. По умолчанию 800/сутки при лимите тарифа 1000:
# запас закрывает расхождение между нашим днём (UTC) и сбросом счётчика у
# провайдера. Счётчик расхода живёт в таблице, а не в памяти, — иначе каждый
# деплой обнулял бы его и кап пробивался бы за день несколько раз.
# YANDEX_GEO_DAILY_CAP="800"
# YANDEX_GEO_PER_MINUTE="20"
# 2ГИС Catalog API — коннектор ещё не написан (PR-3.3).
DGIS_API_KEY=""
# Заглушка источника: выдуманные компании с пометкой «[demo]» в названии.
# Нужна, чтобы пройти весь путь лидогена без ключа. По умолчанию ВЫКЛЮЧЕНА:
# молча подсунуть выдуманные компании в воронку — худшее, что она может.
# SALES_STUB_CONNECTOR="1"

# ─────────────────────────── Режимы ──────────────────────────────────────────
# MAINTENANCE_MODE=1 — отдавать страницу техработ на всё, кроме /api/health.
# MAINTENANCE_MODE="0"
# SKIP_MIGRATIONS=1 — не пытаться мигрировать на старте (БД заведомо лежит).
# SKIP_MIGRATIONS="0"

# ─────────────────────────── Продажи ─────────────────────────────────────────
# Секрет приёма заявок с agentus.space. Agentus шлёт его в заголовке
# `Authorization: Bearer <секрет>` на POST <APP_URL>/api/sales/inbound.
#
# СВОЙ, а не CRON_SECRET: секрет кронов даёт право запускать любые фоновые
# задачи, и класть его в чужое приложение значит расширять радиус поражения с
# «поток мусорных заявок» до «дёргай что хочешь».
#
# Пока пусто — роут отвечает 503, а НЕ принимает всех подряд: забытая
# переменная не должна бесшумно превращаться в публичную форму записи в базу.
# Сгенерировать: openssl rand -base64 36
SALES_INBOUND_SECRET=""
# Потолок заявок в час с одного адреса (по умолчанию 60). Защищает не от
# «на одну больше», а от заливки, если секрет утечёт.
SALES_INBOUND_MAX_PER_HOUR=""

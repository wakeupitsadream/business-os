# ─────────────────────────── База данных (Neon) ──────────────────────────────
# Две строки обязательны: приложение ходит через пул (PgBouncer), миграции —
# напрямую (PgBouncer их не пропускает).
# Взять в консоли Neon → Connection string:
#   • pooled  — хост с суффиксом «-pooler», добавить &pgbouncer=true
#   • direct  — тот же хост БЕЗ «-pooler»
# Перед первой миграцией выполнить в SQL-консоли Neon:
#   CREATE EXTENSION IF NOT EXISTS vector;
# И отключить scale-to-zero (Settings → Compute): минутный крон напоминаний
# и вебхуки Telegram не должны ждать пробуждения БД.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/business_os?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/business_os?sslmode=require"

# ─────────────────────────── Приложение ──────────────────────────────────────
APP_URL="https://os.example.com"
# Подпись cookie-сессии. Сгенерировать: openssl rand -base64 48
AUTH_SECRET=""
# Хэш пароля владельца (argon2id). Сгенерировать: npm run hash:password -- 'мой-пароль'
OWNER_PASSWORD_HASH=""
# Авторизация внутренних крон-вызовов. Сгенерировать: openssl rand -hex 32
CRON_SECRET=""

# ─────────────────────────── LLM-шлюзы ───────────────────────────────────────
# Порядок каскада: первый доступный обслуживает запрос, при провале — следующий.
# Можно оставить один шлюз (LLM_GATEWAYS="polza") — всё работает, но резерва при
# его сбое не будет. Второй ключ добавляется переменной, без правок кода.
LLM_GATEWAYS="polza,proxyapi"
POLZA_API_KEY=""
PROXYAPI_API_KEY=""
# Переопределение моделей по ролям (необязательно — есть дефолты на каждый шлюз).
# Глобальное переопределение применяется ТОЛЬКО к шлюзам с тем же стилем id
# (Polza — namespace «provider/model», ProxyAPI — плоские OpenAI-совместимые):
# иначе LLM_MODEL_SMART="anthropic/..." подставился бы и в ProxyAPI, где такой
# модели нет, и резервный шлюз молча перестал бы работать.
# LLM_MODEL_SMART="anthropic/claude-sonnet-4.5"
# LLM_MODEL_HEAVY="anthropic/claude-opus-4.1"
# LLM_MODEL_CHEAP="openai/gpt-4o-mini"
# LLM_MODEL_EMBED="text-embedding-3-small"
# Точечное переопределение на конкретный шлюз — важнее глобального:
# POLZA_MODEL_SMART="anthropic/claude-sonnet-4.5"
# PROXYAPI_MODEL_CHEAP="gpt-4o-mini"
# Свой адрес шлюза (если провайдер сменил домен):
# POLZA_BASE_URL="https://polza.ai/api/v1"
# PROXYAPI_BASE_URL="https://api.proxyapi.ru/openai/v1"
# Кулдаун circuit-breaker'а деградировавшего шлюза, мс (по умолчанию 45000).
# LLM_BREAKER_COOLDOWN_MS="45000"
# Дневной потолок расходов на LLM в рублях — при превышении шлюз отказывает
# в необязательных вызовах и шлёт алерт (0 = без лимита).
LLM_DAILY_BUDGET_RUB="500"

# ─────────────────────────── Telegram ────────────────────────────────────────
# Личный бот владельца (НЕ бот Agentus). Создать у @BotFather.
TELEGRAM_BOT_TOKEN=""
# Исходящий трафик через Cloudflare Worker: прямой api.telegram.org из Timeweb
# заблокирован, без прокси бот не сможет отправлять сообщения вообще.
# Собственный домен НЕ нужен — подойдёт бесплатный адрес Worker'а
# *.workers.dev (см. infra/cloudflare-worker/README.md).
# Без схемы тоже работает — она подставится.
TELEGRAM_API_BASE="https://telegram-proxy.example.workers.dev"
# Публичная база для setWebhook: вебхук ставится на Worker, он форвардит на
# прод. Прямая доставка Telegram → РФ-хостинг ретраится минутами.
TELEGRAM_WEBHOOK_BASE="https://telegram-proxy.example.workers.dev"
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Единственный chat_id, который бот обслуживает. Узнать: @userinfobot
TELEGRAM_OWNER_CHAT_ID=""

# ─────────────────────────── Распознавание речи ──────────────────────────────
STT_PROVIDER="proxyapi"
STT_MODEL="gpt-4o-mini-transcribe"

# ─────────────────────────── Интеграции (фазы 2–3) ───────────────────────────
# ЮKassa: ОТДЕЛЬНЫЙ ключ только на чтение платежей.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Лидоген: официальные API, скрапинг каталогов запрещён.
YANDEX_GEO_API_KEY=""
DGIS_API_KEY=""
# Приём входящих заявок с agentus.space.
INBOUND_LEAD_SECRET=""

# ─────────────────────────── Режимы ──────────────────────────────────────────
# MAINTENANCE_MODE=1 — отдавать страницу техработ на всё, кроме /api/health.
# MAINTENANCE_MODE="0"
# SKIP_MIGRATIONS=1 — не пытаться мигрировать на старте (БД заведомо лежит).
# SKIP_MIGRATIONS="0"
